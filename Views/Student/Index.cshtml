@model List<StudentMVC.Models.Student>

@{
    ViewData["Title"] = "DANH SACH SINH VIEN";
}

<H2>DANH SACH SINH VIEN</H2>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>id</th>
            <th>name</th>
            <th>age</th>
            <h1>email</h1>
        </tr>
    </thead>
    <tbody>
        @foreach(var student in Model)
        {
            <tr>
                <td>@student.id</td>
                <td>@student.name</td>
                <td>@student.age</td>
                <td>@student.email</td>
            </tr>
        }
    </tbody>
</table>